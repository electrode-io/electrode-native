{
  "name": "ern-platform",
  "version": "1000.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "lerna run build",
    "build:instrument": "npm run build && npm run instrument",
    "check": "npm run check:lint && npm run check:yarnlock",
    "check:lint": "tslint -c tslint.json '**/src/**/*.ts' '**/test/**/*.ts' -e '**/node_modules/**'",
    "check:regen-fixtures": "node regen-fixtures-check",
    "check:yarnlock": "node yarn-lock-check",
    "clean": "lerna clean -y",
    "coverage": "npm run coverage:unit && npm run coverage:system:noclean",
    "coverage:local": "npm run coverage:unit && npm run coverage:system",
    "coverage:system": "npm run build:instrument && nyc --nycrc-path .nycrc.system node system-tests/src/system-tests",
    "coverage:system:noclean": "npm run build:instrument && nyc --nycrc-path .nycrc.system --no-clean node system-tests/src/system-tests",
    "coverage:unit": "nyc --nycrc-path .nycrc.unit npm run test:unit",
    "coverage:upload": "nyc report --reporter=text-lcov | coveralls",
    "ern-debug": "node --nolazy --inspect-brk=5858 ern-local-cli/src/index.dev.js",
    "instrument": "lerna run instrument",
    "prettier:check": "prettier --check '{system-tests/src,global-cli,ern-*}/**/@(*.ts|*.js|*.json)'",
    "prettier:staged": "pretty-quick --staged",
    "prettier:write": "prettier --write '{system-tests/src,global-cli,ern-*}/**/@(*.ts|*.js|*.json)'",
    "regen-fixtures": "node system-tests/src/regen-fixtures",
    "setup-dev": "node setup-dev.js",
    "test": "npm run test:unit && npm run test:system",
    "test:system": "npm run build && lerna run instrument && node system-tests/src/system-tests",
    "test:unit": "lerna run test --no-bail"
  },
  "repository": {
    "type": "git",
